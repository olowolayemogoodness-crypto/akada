{
  "name": "edu",
  "productName": "Edu",
  "version": "0.1.0",
  "description": "Edu: free, open-source learning for Nigerian students. Short videos, a learning map, notes, quizzes and JAMB CBT practice. Works offline on phones and computers.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis portable --x64 --ia32",
    "dist:linux": "electron-builder --linux AppImage",
    "dist": "electron-builder --publish never",
    "build:web": "node scripts/build-web.mjs",
    "serve:web": "npm run build:web && python3 -m http.server 8080 -d www",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "gsap": "3.12.5",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.joinedulink.edu.desktop",
    "productName": "Edu",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "node_modules/three/build/three.module.js",
      "node_modules/three/examples/jsm/**/*",
      "node_modules/gsap/**/*",
      "LICENSE",
      "CONTENT-LICENSE.md"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Edu-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Edu-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Goodness Olowolayemo and contributors",
    "url": "https://joinedulink.com"
  },
  "homepage": "https://edu.joinedulink.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/olowolayemogoodness-crypto/edu.git"
  },
  "keywords": [
    "jamb",
    "cbt",
    "education",
    "nigeria",
    "offline",
    "open-source",
    "exam-prep",
    "android",
    "duolingo-style",
    "short-videos"
  ]
}
